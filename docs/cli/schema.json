{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Reilley64/mods/main/docs/cli/schema.json",
  "title": "mods CLI JSON document",
  "$defs": {
    "warning": {
      "type": "object",
      "required": [
        "code",
        "message",
        "details"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "message": {
          "type": "string"
        },
        "details": {
          "type": "object"
        }
      }
    },
    "problem": {
      "type": "object",
      "required": [
        "type",
        "title",
        "detail",
        "exit_code",
        "code"
      ],
      "properties": {
        "type": {
          "type": "string",
          "pattern": "^https://github\\.com/Reilley64/mods/blob/main/docs/cli/problems\\.md#[a-z_]+$"
        },
        "title": {
          "type": "string"
        },
        "detail": {
          "type": "string"
        },
        "exit_code": {
          "type": "integer"
        },
        "code": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "details": {
          "type": "object"
        },
        "instance": {
          "type": "string"
        },
        "warnings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/warning"
          }
        }
      },
      "not": {
        "required": [
          "status"
        ]
      }
    },
    "setting": {
      "type": "object",
      "required": [
        "key",
        "value",
        "source",
        "manifest_value",
        "manifest_path",
        "shadowed",
        "writable"
      ],
      "properties": {
        "key": {
          "type": "string"
        },
        "value": {
          "type": [
            "string",
            "integer",
            "null"
          ]
        },
        "source": {
          "oneOf": [
            {
              "type": "object",
              "required": [
                "kind"
              ],
              "properties": {
                "kind": {
                  "const": "manifest"
                }
              }
            },
            {
              "type": "object",
              "required": [
                "kind",
                "variable"
              ],
              "properties": {
                "kind": {
                  "const": "environment"
                },
                "variable": {
                  "type": "string"
                }
              }
            },
            {
              "type": "object",
              "required": [
                "kind",
                "argument"
              ],
              "properties": {
                "kind": {
                  "const": "invocation"
                },
                "argument": {
                  "type": "string"
                }
              }
            }
          ]
        },
        "manifest_value": {
          "type": [
            "string",
            "integer",
            "null"
          ]
        },
        "manifest_path": {
          "type": "string"
        },
        "shadowed": {
          "type": "boolean"
        },
        "writable": {
          "type": "boolean"
        }
      }
    },
    "help": {
      "type": "object",
      "required": [
        "help",
        "warnings"
      ],
      "properties": {
        "help": {
          "type": "string"
        },
        "warnings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/warning"
          }
        }
      }
    },
    "version": {
      "type": "object",
      "required": [
        "version",
        "warnings"
      ],
      "properties": {
        "version": {
          "type": "string"
        },
        "warnings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/warning"
          }
        }
      }
    },
    "config_list": {
      "type": "object",
      "required": [
        "settings",
        "warnings"
      ],
      "properties": {
        "settings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/setting"
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/warning"
          }
        }
      }
    },
    "config_get": {
      "type": "object",
      "required": [
        "setting",
        "warnings"
      ],
      "properties": {
        "setting": {
          "$ref": "#/$defs/setting"
        },
        "warnings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/warning"
          }
        }
      }
    },
    "mutation": {
      "type": "object",
      "required": [
        "warnings"
      ],
      "properties": {
        "warnings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/warning"
          }
        }
      }
    },
    "conflict_problem": {
      "type": "object",
      "required": [
        "kind",
        "scope"
      ],
      "properties": {
        "kind": {
          "enum": [
            "modlist_invalid",
            "provider_missing",
            "internal_key_collision",
            "file_directory_collision",
            "ordinary_tombstone_collision",
            "directory_tombstone_descendant_collision",
            "invalid_tombstone_metadata",
            "invalid_tombstone_path",
            "reparse_point",
            "hard_link",
            "unsupported_entry_type",
            "containment_escape",
            "non_lossless_name",
            "reserved_path"
          ]
        },
        "scope": {
          "$ref": "#/$defs/problem_scope"
        }
      }
    },
    "conflict_row": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind",
            "normalized_key",
            "display_path",
            "participation",
            "effective_file",
            "losing_files",
            "content_comparisons"
          ],
          "properties": {
            "kind": {
              "const": "ordinary_conflict"
            },
            "normalized_key": {
              "type": "string"
            },
            "display_path": {
              "type": "string"
            },
            "participation": {
              "enum": [
                "active",
                "inactive",
                "hypothetical"
              ]
            },
            "effective_file": {
              "$ref": "#/$defs/provider"
            },
            "losing_files": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/provider"
              }
            },
            "content_comparisons": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/comparison"
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "normalized_key",
            "display_path",
            "participation",
            "controlling_tombstone",
            "suppressed_entries"
          ],
          "properties": {
            "kind": {
              "const": "tombstone"
            },
            "normalized_key": {
              "type": "string"
            },
            "display_path": {
              "type": "string"
            },
            "participation": {
              "enum": [
                "active",
                "inactive",
                "hypothetical"
              ]
            },
            "controlling_tombstone": {
              "$ref": "#/$defs/tombstone"
            },
            "suppressed_entries": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/provider"
              }
            }
          }
        }
      ]
    },
    "conflicts_list": {
      "type": "object",
      "required": [
        "resolution_status",
        "rows",
        "problems",
        "warnings"
      ],
      "properties": {
        "resolution_status": {
          "enum": [
            "exact",
            "invalid"
          ]
        },
        "rows": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/conflict_row"
          }
        },
        "problems": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/conflict_problem"
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/warning"
          }
        }
      },
      "not": {
        "anyOf": [
          {
            "required": [
              "mod_name"
            ]
          },
          {
            "required": [
              "normalized_key"
            ]
          }
        ]
      }
    },
    "conflicts_inspect": {
      "type": "object",
      "required": [
        "resolution_status",
        "rows",
        "problems",
        "warnings",
        "mod_name",
        "participation",
        "provider_summary"
      ],
      "properties": {
        "resolution_status": {
          "enum": [
            "exact",
            "invalid"
          ]
        },
        "rows": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/conflict_row"
          }
        },
        "problems": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/conflict_problem"
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/warning"
          }
        },
        "mod_name": {
          "type": "string"
        },
        "participation": {
          "enum": [
            "active",
            "inactive",
            "hypothetical"
          ]
        },
        "provider_summary": {
          "$ref": "#/$defs/provider_summary"
        }
      }
    },
    "conflicts_explain": {
      "type": "object",
      "required": [
        "normalized_key",
        "display_path",
        "resolution_status",
        "effective_result",
        "provider_stack",
        "tombstone_effects",
        "content_comparisons",
        "reasons",
        "problems",
        "warnings"
      ],
      "properties": {
        "normalized_key": {
          "type": "string"
        },
        "display_path": {
          "type": "string"
        },
        "resolution_status": {
          "enum": [
            "exact",
            "invalid"
          ]
        },
        "effective_result": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "kind",
                "provider"
              ],
              "properties": {
                "kind": {
                  "const": "file"
                },
                "provider": {
                  "$ref": "#/$defs/provider"
                }
              }
            },
            {
              "type": "object",
              "required": [
                "kind",
                "controlling_tombstone"
              ],
              "properties": {
                "kind": {
                  "const": "absent"
                },
                "controlling_tombstone": {
                  "oneOf": [
                    {
                      "type": "null"
                    },
                    {
                      "$ref": "#/$defs/tombstone"
                    }
                  ]
                }
              }
            }
          ]
        },
        "provider_stack": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/provider"
          }
        },
        "tombstone_effects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/tombstone_effect"
          }
        },
        "content_comparisons": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/comparison"
          }
        },
        "reasons": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reason"
          }
        },
        "problems": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/conflict_problem"
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/warning"
          }
        }
      }
    },
    "install_additional": {
      "type": "object",
      "required": [
        "outcome",
        "archive_identity",
        "mod_name",
        "accepted_choices",
        "groups",
        "warnings"
      ],
      "properties": {
        "outcome": {
          "const": "additional_selections_required"
        },
        "archive_identity": {
          "$ref": "#/$defs/archive_identity"
        },
        "mod_name": {
          "type": "string"
        },
        "accepted_choices": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/accepted_choice"
          }
        },
        "groups": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fomod_group"
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/warning"
          }
        }
      }
    },
    "install_preview": {
      "type": "object",
      "required": [
        "outcome",
        "plan",
        "hypothetical_enabled_conflicts",
        "warnings"
      ],
      "properties": {
        "outcome": {
          "const": "preview"
        },
        "plan": {
          "$ref": "#/$defs/install_plan"
        },
        "hypothetical_enabled_conflicts": {
          "type": "object",
          "required": [
            "resolution_status",
            "rows",
            "problems"
          ],
          "properties": {
            "resolution_status": {
              "enum": [
                "exact",
                "invalid"
              ]
            },
            "rows": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/conflict_row"
              }
            },
            "problems": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/conflict_problem"
              }
            }
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/warning"
          }
        }
      }
    },
    "install_installed": {
      "type": "object",
      "required": [
        "outcome",
        "warnings"
      ],
      "properties": {
        "outcome": {
          "const": "installed"
        },
        "warnings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/warning"
          }
        }
      }
    },
    "provider_rank": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "base"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "priority"
          ],
          "properties": {
            "kind": {
              "const": "regular"
            },
            "priority": {
              "type": "integer"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "overwrite"
            }
          }
        }
      ]
    },
    "provider": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind",
            "priority",
            "original_path",
            "participation_reason"
          ],
          "properties": {
            "kind": {
              "const": "steam_data"
            },
            "priority": {
              "$ref": "#/$defs/provider_rank"
            },
            "original_path": {
              "type": "string"
            },
            "participation_reason": {
              "const": "steam_base"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "mod_name",
            "priority",
            "original_path",
            "participation_reason"
          ],
          "properties": {
            "kind": {
              "const": "data_mod"
            },
            "mod_name": {
              "type": "string"
            },
            "priority": {
              "$ref": "#/$defs/provider_rank"
            },
            "original_path": {
              "type": "string"
            },
            "participation_reason": {
              "enum": [
                "enabled_mod",
                "disabled_mod",
                "hypothetical_enabled_mod",
                "projected_disabled_mod",
                "overwrite",
                "steam_base"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "priority",
            "original_path",
            "participation_reason"
          ],
          "properties": {
            "kind": {
              "const": "overwrite"
            },
            "priority": {
              "$ref": "#/$defs/provider_rank"
            },
            "original_path": {
              "type": "string"
            },
            "participation_reason": {
              "const": "overwrite"
            }
          }
        }
      ]
    },
    "tombstone": {
      "type": "object",
      "required": [
        "scope",
        "owner"
      ],
      "properties": {
        "scope": {
          "enum": [
            "exact_file",
            "directory_subtree"
          ]
        },
        "owner": {
          "$ref": "#/$defs/provider"
        }
      }
    },
    "comparison": {
      "type": "object",
      "required": [
        "state",
        "winner",
        "loser"
      ],
      "properties": {
        "state": {
          "enum": [
            "not_compared",
            "same_sha256",
            "different_sha256",
            "unavailable",
            "unstable"
          ]
        },
        "winner": {
          "$ref": "#/$defs/provider"
        },
        "loser": {
          "$ref": "#/$defs/provider"
        },
        "winner_sha256": {
          "type": "string"
        },
        "loser_sha256": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "enum": [
                  "same_sha256",
                  "different_sha256"
                ]
              }
            }
          },
          "then": {
            "required": [
              "winner_sha256",
              "loser_sha256"
            ]
          }
        }
      ]
    },
    "provider_summary": {
      "type": "object",
      "required": [
        "ordinary_file_count",
        "effective_file_count",
        "file_conflict_win_count",
        "file_conflict_loss_count",
        "owned_file_tombstone_count",
        "owned_directory_tombstone_count",
        "lower_file_entries_suppressed_count",
        "own_file_entries_suppressed_count",
        "state"
      ],
      "properties": {
        "ordinary_file_count": {
          "type": "integer"
        },
        "effective_file_count": {
          "type": "integer"
        },
        "file_conflict_win_count": {
          "type": "integer"
        },
        "file_conflict_loss_count": {
          "type": "integer"
        },
        "owned_file_tombstone_count": {
          "type": "integer"
        },
        "owned_directory_tombstone_count": {
          "type": "integer"
        },
        "lower_file_entries_suppressed_count": {
          "type": "integer"
        },
        "own_file_entries_suppressed_count": {
          "type": "integer"
        },
        "state": {
          "enum": [
            "invalid",
            "inactive",
            "suppression_only",
            "empty",
            "fully_overridden",
            "mixed",
            "winning_conflicts",
            "losing_conflicts",
            "uncontested"
          ]
        }
      }
    },
    "archive_identity": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind",
            "archive_sha256",
            "package_root"
          ],
          "properties": {
            "kind": {
              "const": "data_archive"
            },
            "archive_sha256": {
              "type": "string"
            },
            "package_root": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "archive_sha256",
            "package_root",
            "config_member",
            "config_sha256"
          ],
          "properties": {
            "kind": {
              "const": "fomod"
            },
            "archive_sha256": {
              "type": "string"
            },
            "package_root": {
              "type": "string"
            },
            "config_member": {
              "type": "string"
            },
            "config_sha256": {
              "type": "string"
            }
          }
        }
      ]
    },
    "accepted_choice": {
      "type": "object",
      "required": [
        "group_id",
        "option_id"
      ],
      "properties": {
        "group_id": {
          "type": "string"
        },
        "option_id": {
          "type": "string"
        }
      }
    },
    "fomod_option": {
      "type": "object",
      "required": [
        "id",
        "label",
        "description",
        "resolved_type",
        "selectable",
        "synthetic"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "resolved_type": {
          "enum": [
            "required",
            "not_usable",
            "recommended",
            "optional",
            "could_be_usable"
          ]
        },
        "selectable": {
          "type": "boolean"
        },
        "synthetic": {
          "type": "boolean"
        }
      }
    },
    "fomod_group": {
      "type": "object",
      "required": [
        "id",
        "label",
        "description",
        "cardinality",
        "options"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "cardinality": {
          "enum": [
            "select_exactly_one",
            "select_at_most_one",
            "select_at_least_one",
            "select_any",
            "select_all"
          ]
        },
        "options": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fomod_option"
          }
        }
      }
    },
    "install_provider": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind",
            "original_path"
          ],
          "properties": {
            "kind": {
              "const": "steam_data"
            },
            "original_path": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "mod_name",
            "priority",
            "original_path",
            "participation_reason"
          ],
          "properties": {
            "kind": {
              "const": "data_mod"
            },
            "mod_name": {
              "type": "string"
            },
            "priority": {
              "type": "integer"
            },
            "original_path": {
              "type": "string"
            },
            "participation_reason": {
              "enum": [
                "steam_base",
                "enabled_mod",
                "disabled_mod",
                "hypothetical_enabled_mod",
                "projected_disabled_mod",
                "overwrite"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "original_path"
          ],
          "properties": {
            "kind": {
              "const": "overwrite"
            },
            "original_path": {
              "type": "string"
            }
          }
        }
      ]
    },
    "install_tombstone": {
      "type": "object",
      "required": [
        "scope",
        "owner"
      ],
      "properties": {
        "scope": {
          "enum": [
            "exact_file",
            "directory_subtree"
          ]
