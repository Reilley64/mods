{
  "name": "mods-repository-tools",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "check": "bun run format:check && bun run lint && bun run dependency:check && bun run test",
    "format:check": "cargo fmt --all -- --check",
    "lint": "cargo clippy --workspace --all-targets --all-features -- -D warnings",
    "dependency:check": "bun scripts/check-dependency-graph.ts",
    "test": "cargo nextest run --workspace --all-targets && bun test tests ./.prime/agent/extensions/coding-style-gate/tests",
    "check:pr-title": "bun scripts/validate-pr-title.ts"
  },
  "dependencies": {
    "@typesafe-ai/sdk": "0.6.0",
    "diff": "8.0.4"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "msw": "2.15.0"
  },
  "packageManager": "bun@1.4.2"
}
