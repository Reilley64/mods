{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "rust",
  "bump-minor-pre-major": true,
  "bump-patch-for-minor-pre-major": false,
  "separate-pull-requests": false,
  "group-pull-request-title-pattern": "chore: prepare v${version} release",
  "plugins": [
    {
      "type": "cargo-workspace",
      "merge": false,
      "updateAllPackages": false
    }
  ],
  "packages": {
    ".": {
      "release-type": "simple",
      "component": "mods",
      "package-name": "mods",
      "initial-version": "0.1.0",
      "version-file": "version.txt",
      "changelog-path": "CHANGELOG.md",
      "include-component-in-tag": false,
      "skip-github-release": false
    },
    "src/domain": {
      "release-type": "rust",
      "component": "domain",
      "package-name": "domain",
      "skip-github-release": true,
      "skip-changelog": true
    },
    "src/application": {
      "release-type": "rust",
      "component": "application",
      "package-name": "application",
      "skip-github-release": true,
      "skip-changelog": true
    },
    "src/infrastructure/environment": {
      "release-type": "rust",
      "component": "environment",
      "package-name": "environment",
      "skip-github-release": true,
      "skip-changelog": true
    },
    "src/infrastructure/settings": {
      "release-type": "rust",
      "component": "settings",
      "package-name": "settings",
      "skip-github-release": true,
      "skip-changelog": true
    },
    "src/infrastructure/game_platform": {
      "release-type": "rust",
      "component": "game-platform",
      "package-name": "game-platform",
      "skip-github-release": true,
      "skip-changelog": true
    },
    "src/infrastructure/archive": {
      "release-type": "rust",
      "component": "archive",
      "package-name": "archive",
      "skip-github-release": true,
      "skip-changelog": true
    },
    "src/infrastructure/execution": {
      "release-type": "rust",
      "component": "execution",
      "package-name": "execution",
      "skip-github-release": true,
      "skip-changelog": true
    },
    "src/infrastructure/dependencies": {
      "release-type": "rust",
      "component": "infrastructure",
      "package-name": "infrastructure",
      "skip-github-release": true,
      "skip-changelog": true
    },
    "src/presentation/cli": {
      "release-type": "rust",
      "component": "mods-cli",
      "package-name": "mods",
      "include-component-in-tag": true,
      "skip-github-release": true,
      "skip-changelog": true
    },
    "src/presentation/mcp": {
      "release-type": "rust",
      "component": "mods-mcp",
      "package-name": "mods-mcp",
      "include-component-in-tag": true,
      "skip-github-release": true,
      "skip-changelog": true
    }
  }
}
